<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext (http://) is allowed so a personal backend on your home Wi-Fi (e.g. http://192.168.1.20:8000)
     works. The app warns you in Settings when a non-local http URL is configured. Prefer https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
